    Shopify.current_product = {...{"id":8334799831351,"title":"RHS Lobelia Cascade Blue Seeds","handle":"rhs-lobelia-cascade-blue","description":"A mass of vivid little blue flowers appear profusely over a long season. The vigorous, trailing plants are the perfect choice for container and basket displays.\u003cbr\u003eWinner of an RHS Award of Garden Merit for reliability and good performance.\u003cbr\u003ePart of the seed range produced by Mr Fothergill’s Seeds in partnership with the RHS.","published_at":"2023-11-03T00:26:51+00:00","created_at":"2023-05-17T16:14:17+01:00","vendor":"Mr Fothergills","type":"FLOWER SEEDS","tags":["classification:half-hardy annual","Collection:all products (excluding drop ship HARDWARE)","Collection:Flowers To Sow In April","Collection:Flowers To Sow In February","Collection:Flowers To Sow In January","Collection:Flowers To Sow In March","Collection:Lobelia Seeds","Collection:MRF all products exc all hardware","garden style:formal","garden type:bedding","garden type:borders","harvest:august","harvest:july","harvest:june","harvest:october","harvest:september","plant class:half hardy annual","product family:flower","product family:flower seeds","product type:seeds","seeds:excludes99p","sow indoors:april","sow indoors:february","sow indoors:january","sow indoors:march"],"price":366,"price_min":366,"price_max":366,"available":true,"price_varies":false,"compare_at_price":366,"compare_at_price_min":366,"compare_at_price_max":366,"compare_at_price_varies":false,"variants":[{"id":45383984709943,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"27424","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"name":"RHS Lobelia Cascade Blue Seeds","public_title":null,"options":["Default Title"],"price":366,"weight":4,"compare_at_price":366,"inventory_management":"shopify","barcode":"5011775274249","requires_selling_plan":false,"selling_plan_allocations":[],"quantity_rule":{"min":1,"max"