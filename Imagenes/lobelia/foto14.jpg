                        >£3.66</span>
                      </div>
                    </div></label></div></div></variant-picker><script>
  (() => {
    if (window.customElements.get('back-in-stock-form')) {
      return;
    }

    class BackInStockForm extends HTMLElement {
      connectedCallback() {
        this.form = this.querySelector('form');

        if (!this.form || this._onSubmitListener) {
          return;
        }

        this._onSubmitListener = this._onSubmit.bind(this);
        this.form.addEventListener('submit', this._onSubmitListener);
      }

      disconnectedCallback() {
        if (this.form && this._onSubmitListener) {
          this.form.removeEventListener('submit', this._onSubmitListener);
        }
      }

      _resetMessages() {
        const info = this.form.querySelector('.form-info');
        const success = this.form.querySelector('.form-success');
        const error = this.form.querySelector('.form-error');

        if (info) info.style.display = 'none';
        if (success) success.style.display = 'none';
        if (error) error.style.display = 'none';

        this.form.classList.remove('success', 'error');
      }

      _showSuccess() {
        const info = this.form.querySelector('.form-info');
        const success = this.form.querySelector('.form-success');
        const error = this.form.querySelector('.form-error');

        if (info) info.style.display = 'none';
        if (error) error.style.display = 'none';
        if (success) success.style.display = 'block';

        this.form.classList.add('success');
        this.form.classList.remove('error');
      }

      _showError() {
        const info = this.form.querySelector('.form-info');
        const success = this.form.querySelector('.form-success');
        const error = this.form.querySelector('.form-error');

        if (info) info.style.display = 'none';
        if (success) success.style.display = 'none';
        if (error) error.style.display = 'block';

        this.form.classList.add('error');
        this.form.classList.remove('success');
      }

      async _onSubmit(event) {
        event.preventDefault();

        this._resetMessages();

        const formData = new FormData(event.target);
        const payload = {
          data: {
            type: 'back-in-stock-subscription',
            attributes: {
              profile: {
                data: {
                  type: 'profile',
                  attributes: {
                    email: formData.get('email')
                  }
                }
              },
              channels: ['EMAIL']
            },
            relationships: {
              variant: {
                data: {
                  type: 'catalog-variant',
                  id: `$shopify:::$default:::${formData.get('variant_id')}`
                }
              }
            }
          }
        };

        try {
          const response = await fetch('https://a.klaviyo.com/client/back-in-stock-subscriptions/?company_id=VNnzqY', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              revision: '2024-06-15'
            },
            body: JSON.stringify(payload)
          });

          if (response.status === 202) {
            this._showSuccess();
          } else {
            this._showError();
          }
        } catch (error) {
          console.log('error', error);
          this._showError();
        }
      }
    }

    window.customElements.define('back-in-stock-form', BackInStockForm);
  })();
</script>

<script>
  (() => {
    if (window.__backInStockToggleInitialized) return;
    window.__backInStockToggleInitialized = true;

    document.addEventListener('click', (event) => {
      const toggle = event.target.closest('[data-back-in-stock-toggle]');
      if (!toggle) return;
      const card = toggle.closest('[data-variant-picker-label]');
      if (!card) return;
      const form = card.querySelector('back-in-stock-form');
      if (!form) return;
      const isOpen = form.style.maxHeight && form.style.maxHeight !== '0px';
      if (isOpen) {
        form.style.maxHeight = '0';
      } else {
        form.style.maxHeight = form.scrollHeight + 'px';
        form.querySelector('input[type="email"]')?.focus();
      }
      toggle.setAttribute('aria-expanded', String(!isOpen));
    });
  })();
</script>

<script>
  (() => {
    if (window.__variantPickerLabelSyncInitialized) {
      return;
    }

    window.__variantPickerLabelSyncInitialized = true;

    const selectedLabelClasses = ['border-[#058470]', 'bg-[#f0fdf4]'];
    const betterValueLabelClasses = ['border-[#058470]', 'bg-[#f8fefb]'];
    const unselectedLabelClasses = ['border-[#e5e7eb]'];
    const outOfStockLabelClasses = ['border-[#e5e7eb]', 'bg-[#f7f7f7]'];
    const outOfSeasonLabelClasses = ['border-[#e5e7eb]', 'bg-[#f7f7f7]'];

    const syncOptionSelector = (optionSelector) => {
      if (!optionSelector) {
        return;
      }

      optionSelector.querySelectorAll('[data-variant-picker-label]').forEach((label) => {
        const input = label.querySelector('[data-variant-picker-radio]');
        const check = label.querySelector('.variant-check');
        const isDisabled = label.classList.contains('is-disabled');
        const isSelected = !!input?.checked && !isDisabled;
        const isOutOfSeason = label.hasAttribute('data-out-of-season');
        const hasBetterValue = label.classList.contains('has-better-value');

        label.classList.toggle('is-selected', isSelected);
        label.classList.remove(
          ...selectedLabelClasses,
          ...betterValueLabelClasses,
          ...unselectedLabelClasses,
          ...outOfStockLabelClasses,
          ...outOfSeasonLabelClasses
        );
        if (isSelected) {
          label.classList.add(...selectedLabelClasses);
        } else if (isOutOfSeason) {
          label.classList.add(...outOfSeasonLabelClasses);
        } else if (isDisabled) {
          label.classList.add(...outOfStockLabelClasses);
        } else if (hasBetterValue) {
          label.classList.add(...betterValueLabelClasses);
        } else {
          label.classList.add(...unselectedLabelClasses);
        }

        if (check) {
          check.classList.toggle('is-selected', isSelected);
          check.classList.toggle('opacity-100', isSelected);
          check.classList.toggle('opacity-0', !isSelected);
          check.classList.toggle('hidden', !isSelected);
        }
      });
    };

    const syncFormOptionSelectors = (formId) => {
      if (!formId) {
        return;
      }

      const optionSelectors = new Set();

      document.querySelectorAll(`[data-variant-picker-radio][form="${CSS.escape(formId)}"]`).forEach((input) => {
        const optionSelector = input.closest('[data-option-selector]');

        if (optionSelector) {
          optionSelectors.add(optionSelector);
        }
      });

      optionSelectors.forEach((optionSelector) => syncOptionSelector(optionSelector));
    };

    document.addEventListener('change', (event) => {
      const input = event.target;

      if (!input.matches('[data-variant-picker-radio]') || !input.checked) {
        return;
      }

      syncOptionSelector(input.closest('[data-option-selector]'));
    });

    document.addEventListener('variant:change', (event) => {
      syncFormOptionSelectors(event.target?.id);
    });

    document.querySelectorAll('[data-option-selector]').forEach((optionSelector) => {
      if (optionSelector.querySelector('[data-variant-picker-radio]')) {
        syncOptionSelector(optionSelector);
      }
    });
  })();
</script><script type='application/json' data-variant-out-of-season='8334799831351'>
