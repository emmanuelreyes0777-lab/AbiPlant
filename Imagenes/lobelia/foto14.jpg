        </button>
      </li><li class='shrink-0 items-center' data-breadcrumb-middle aria-hidden='true'>></li>
          <li class='min-w-0 items-center' data-breadcrumb-middle>
            <a class='breadcrumbs__link' href='/collections/lobelia-seeds'>Lobelia Seeds</a>
          </li><li class='inline-flex shrink-0 items-center' aria-hidden='true'>></li>
      <li class='inline-flex min-w-0 items-center' data-breadcrumb-current>
        <span class='block font-bold' aria-current='page'>RHS Lobelia Cascade Blue Seeds</span>
      </li></ol><script>
      (function () {
        var nav = document.currentScript && document.currentScript.closest('[data-breadcrumbs]');
        if (!nav || nav.dataset.bound === 'true') return;
        nav.dataset.bound = 'true';

        var list = nav.querySelector('[data-breadcrumb-list]');
        var btn = nav.querySelector('[data-breadcrumb-expand]');
        if (!list || !btn) return;

        btn.addEventListener('click', function () {
          nav.setAttribute('data-expanded', '');
        });

        // Decide expand vs collapsed first, then reveal (never the other way round).
        function reveal() {
          nav.setAttribute('data-ready', '');
        }

        function decide() {
          if (nav.dataset.measured === 'true') {
            reveal();
            return;
          }
          nav.dataset.measured = 'true';

          if (window.matchMedia('(max-width: 767px)').matches) {
            var width = list.getBoundingClientRect().width;
            if (width >= 100) {
              var probe = list.cloneNode(true);
              probe.querySelectorAll('[data-breadcrumb-ellipsis]').forEach(function (el) {
                el.remove();
              });
              probe.querySelectorAll('[data-breadcrumb-middle]').forEach(function (el) {
                el.style.setProperty('display', 'inline-flex', 'important');
                el.style.setProperty('flex-shrink', '0', 'important');
                el.style.setProperty('min-width', 'max-content', 'important');
              });
              probe.querySelectorAll(':scope > li').forEach(function (el) {
                el.style.setProperty('flex-shrink', '0', 'important');
                el.style.setProperty('min-width', 'max-content', 'important');
              });
              var cur = probe.querySelector('[data-breadcrumb-current] [aria-current="page"]');
              if (cur) {
                cur.style.setProperty('overflow', 'visible', 'important');
                cur.style.setProperty('text-overflow', 'clip', 'important');
                cur.style.setProperty('white-space', 'nowrap', 'important');
              }
              var cs = window.getComputedStyle(list);
              probe.style.cssText =
                'position:absolute;left:0;top:0;visibility:hidden;pointer-events:none;z-index:-1;display:flex;flex-wrap:nowrap;align-items:center;width:' +
                width +
                'px;margin:0;padding:0;list-style:none;gap:' +
                cs.columnGap +
                ';font:' +
                cs.font +
                ';letter-spacing:' +
                cs.letterSpacing +
                ';';
              document.body.appendChild(probe);
              var fits = probe.scrollWidth <= width + 1;
              probe.remove();
              if (fits) nav.setAttribute('data-expanded', '');
            }
          }

          // Let expanded/collapsed styles apply before fading in
          requestAnimationFrame(function () {
            requestAnimationFrame(reveal);
          });
        }

        function scheduleDecide() {
          requestAnimationFrame(function () {
            requestAnimationFrame(decide);
          });
        }

        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(scheduleDecide);
        } else {
          scheduleDecide();
        }
        // Fallback still runs the full decide path — never reveal-only
        setTimeout(decide, 2000);
      })();
    </script></nav>
    </div>
</div>

