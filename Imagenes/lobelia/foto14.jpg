<div
  x-cloak
  class='rm-mega-menu'
  data-mega-menu-id='special-offers'
  data-menu-store-key='special-offers'
  data-shop-all-links='[{&quot;index&quot;:0,&quot;url&quot;:&quot;\/collections\/vegetable-seeds&quot;,&quot;title&quot;:&quot;Offers&quot;}]'
  data-single-column-panels='[]'
  :class="{ 'panel-open': $store.megaMenu.open === storeKey }"
  x-data="rmMegaMenu({ storeKey: 'special-offers', basePromoCount: 2, extraPromoCount: 0 })"
  x-show='!isMobile() && $store.megaMenu.open === storeKey'
  @mouseenter='
    if (!isMobile() && $store.megaMenu.open !== storeKey) {
      $store.megaMenu.open = storeKey
    }
  '
  @mouseleave='if (!isMobile() && window.menuDebug?.keepOpen !== true) { $store.megaMenu.open = null }'
>
  <div class='rm-mega-menu__inner'>
    
<div
        class='rm-mega-menu__desktop'
        x-show='!isMobile()'
        :class='desktopPromosClass()'
      >
        <aside class='rm-mega-menu__sidebar'>
          <nav class='rm-mega-menu__sidebar-nav' aria-label='Offers'>
            
              
              <a
                href='/collections/vegetable-seeds'
                class='rm-mega-menu__sidebar-link'
                data-link-index='0'
