      <div class='rm-mega-menu__overlay'></div>
      <navigation-menu
        class='navigation header__nav-main lg:block'
        x-data='{ _prevBurgerOpen: false }'
        x-init="
          if (!Alpine.store('megaMenu')) Alpine.store('megaMenu', { open: null });
          if (!Alpine.store('megaMenu2')) Alpine.store('megaMenu2', { open: null });
          if (!Alpine.store('burgerMenu')) Alpine.store('burgerMenu', { open: false });
          const updateMegaMenuOpen = () => {
            const isMegaMenuOpen =
              ($store.megaMenu && $store.megaMenu.open !== null) ||
              ($store.megaMenu2 && $store.megaMenu2.open !== null);
            const isBurgerOpen = ($store.burgerMenu && $store.burgerMenu.open) || false;
            document.body.classList.toggle('rm-mega-menu--open', isMegaMenuOpen || isBurgerOpen);
          };
          _prevBurgerOpen = $store.burgerMenu.open;
          updateMegaMenuOpen();
          $watch('$store.megaMenu.open', updateMegaMenuOpen);
          $watch('$store.megaMenu2.open', updateMegaMenuOpen);
          $watch('$store.burgerMenu.open', (open) => {
            updateMegaMenuOpen();
            if (_prevBurgerOpen && !open) {
              $el.querySelectorAll('details[is=accordion-disclosure]').forEach((accordion) => {
                accordion.open = false;
              });
            }
            _prevBurgerOpen = open;
          });
        "
        :class="{ 'nav-main--open': $store.burgerMenu && $store.burgerMenu.open }"
        @mouseover="
          if (window.innerWidth < 1000) return;
          const item = $event.target.closest('.navigation__main_menu > .menu__item[data-mega-menu-open-key]');
          if (!item) return;
          $store.megaMenu.open = item.dataset.megaMenuOpenKey;
          $el.querySelectorAll('.navigation__main_menu > .menu__item').forEach((navItem) => {
            navItem.classList.toggle('is-open', navItem === item);
          });
        "
        @mouseleave="
          if (window.innerWidth < 1000) return;
          $store.megaMenu.open = null;
          $el.querySelectorAll('.navigation__main_menu > .menu__item.is-open').forEach((item) => item.classList.remove('is-open'));
        "
      >
