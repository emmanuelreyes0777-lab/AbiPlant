    @media screen and (min-width: 1400px) {
      #shopify-section-template--26102891807098__main {
        --product-gallery-media-list-gap: var(--grid-gutter);
      }
    }

    .product .price-list .text-subdued {
      font-size: 28px;
      line-height: 1;
  }

  #shopify-section-template--26102891807098__main .section:has([data-breadcrumbs]) {
    padding-block-end: 0;
