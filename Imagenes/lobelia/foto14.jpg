      --cursor-zoom-in-svg-url: url(//mr-fothergills.co.uk/cdn/shop/t/188/assets/img-cursor-zoom-in.svg.liquid?v=154953035094101115921773828317);
      --cursor-zoom-out-svg-url: url(//mr-fothergills.co.uk/cdn/shop/t/188/assets/img-cursor-zoom-out.svg.liquid?v=16155520337305705181773828317);
