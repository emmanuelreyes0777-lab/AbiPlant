  }

  #product-description .product-info-tabs-mobile .product-info-tabs-mobile__accordion .accordion__content {
    padding-inline: 1rem;
    padding-bottom: 1rem;
    transform: none;
  }

  /*
    Desktop PDP tabs: horizontal carousel (JS translates track). Full panel width slide;
    outgoing panel leaves with the same motion as the incoming panel — no instant collapse.
  */
  #product-description .pip-dsk-carousel-viewport {
    overflow-x: hidden;
    overflow-y: hidden;
    transition: height 0.5s cubic-bezier(0.33, 1, 0.68, 1);
  }

  #product-description .pip-dsk-carousel-track {
    will-change: transform;
    transition: transform 0.5s cubic-bezier(0.33, 1, 0.68, 1);
    backface-visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    #product-description .pip-dsk-carousel-track {
      transition: none;
    }

    #product-description .pip-dsk-carousel-viewport {
      transition: none;
    }
  }

  #product-description .product-info-tabs-desktop .pip-dsk-tab-wrap .pip-dsk-panel-slides {
