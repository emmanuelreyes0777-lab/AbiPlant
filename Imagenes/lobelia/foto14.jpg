    Shopify.current_product.current_variant = {...{"id":45383984709943,"title":"Default Title","option1":"Default Title","option2":null,"option3":null,"sku":"27424","requires_shipping":true,"taxable":true,"featured_image":null,"available":true,"name":"RHS Lobelia Cascade Blue Seeds","public_title":null,"options":["Default Title"],"price":366,"weight":4,"compare_at_price":366,"inventory_management":"shopify","barcode":"5011775274249","requires_selling_plan":false,"selling_plan_allocations":[],"quantity_rule":{"min":1,"max":null,"increment":1}}};
    Shopify.current_product['collections'] = Object.values({...[{"id":459817222455,"handle":"all","title":"ALL","updated_at":"2026-09-30T01:11:27+01:00","body_html":"","published_at":"2024-03-15T08:56:41+00:00","sort_order":"alpha-asc","template_suffix":"","disjunctive":false,"rules":[{"column":"variant_price","relation":"greater_than","condition":"0"}],"published_scope":"global"},{"id":476683305271,"handle":"all-products-excluding-dropship-hardware","title":"All products","updated_at":"2026-09-30T01:11:27+01:00","body_html":"","published_at":"2024-03-20T15:32:30+00:00","sort_order":"best-selling","template_suffix":"","disjunctive":false,"rules":[{"column":"tag","relation":"equals","condition":"Collection:all products (excluding drop ship HARDWARE)"}],"published_scope":"global","image":{"created_at":"2024-03-24T07:02:55+00:00","alt":null,"width":2000,"height":1000,"src":"\/\/mr-fothergills.co.uk\/cdn\/shop\/collections\/MRF_pre_order_banner.jpg?v=1711263775"}},{"id":468328907063,"handle":"all-seeds","title":"All Seeds","updated_at":"2026-09-30T01:11:27+01:00","body_html":"\u003cp\u003eGrow something special together with our trusted, easy-to-grow seeds. Enjoy more moments in the garden with Fothergills Seeds.\u003c\/p\u003e","published_at":"2024-08-08T20:41:53+01:00","sort_order":"created-desc","template_suffix":"","disjunctive":true,"rules":[{"column":"type","relation":"equals","condition":"FLOWER SEEDS"},{"column":"type","relation":"equals","condition":"VEGETABLE SEEDS"}],"published_scope":"global"},{"id":459165532471,"handle":"bedding-seeds","title":"Bedding \u0026 Borders","updated_at":"2026-09-30T01:11:27+01:00","body_html":"\u003cp\u003eBedding seeds are the key to creating a garden bursting with colour and personality. Whether you love the soft pastels of spring or the bold, bright shades of summer, our range has something to suit every planting style. These eager-to-please flowers are perfect for filling beds, borders, and containers, bringing months of floral beauty to your outdoor space.\u003c\/p\u003e\n\u003cp\u003eFrom classic favourites like \u003ca href=\"\/collections\/petunia-seeds\"\u003ePetunia seeds\u003c\/a\u003e and \u003ca href=\"\/collections\/marigold-seeds\"\u003eMarigold seeds\u003c\/a\u003e to delicate \u003ca href=\"\/collections\/lobelia-seeds\"\u003eLobelia seeds\u003c\/a\u003e, there’s a world of choice to explore. Many bedding plants bloom for weeks on end, keeping your garden looking fresh and full of life all season long.\u003c\/p\u003e\n\u003cp\u003eSow your summer bedding seeds in spring for a dazzling display, or choose spring flowering bedding plants to bring colour to the early months of the year. Whatever your vision, our bedding seeds make growing a garden you’ll love easy.\u003c\/p\u003e","published_at":"2023-08-24T16:13:29+01:00","sort_order":"best-selling","template_suffix":"","disjunctive":false,"rules":[{"column":"tag","relation":"equals","condition":"garden type:bedding"}],"published_scope":"global","image":{"created_at":"2023-09-19T15:11:59+01:00","alt":null,"width":1536,"height":1536,"src":"\/\/mr-fothergills.co.uk\/cdn\/shop\/collections\/summer_bedding_collection_fothergills.jpg?v=1695132719"}},{"id":673286717818,"handle":"bedding-flowers-seeds","title":"Bedding Flowers","updated_at":"2026-09-29T12:41:54+01:00","body_html":"\u003cspan\u003e\u003cstrong\u003eBedding Flower Seeds\u003c\/strong\u003e\u003cbr\u003eBedding flower seeds are a simple and affordable way to create vibrant, colorful displays in your garden. These flowers are grown for a single season and are perfect for planting in borders, containers, hanging baskets or window boxes to achieve a bold, coordinated look. Ideal for the UK climate, bedding flowers grow quickly and bloom generously, making them a favorite for adding instant impact to outdoor spaces. With a wide range of colors, shapes and sizes to choose from, bedding flower seeds allow you to refresh your garden design every year with stunning seasonal displays.\u003c\/span\u003e\n","published_at":"2025-08-28T10:48:00+01:00","sort_order":"best-selling","template_suffix":"","disjunctive":false,"rules":[{"column":"tag","relation":"equals","condition":"garden type:bedding"},{"column":"type","relation":"equals","condition":"FLOWER SEEDS"}],"published_scope":"global"},{"id":457031090487,"handle":"flower-seeds","title":"Flower Seeds","updated_at":"2026-09-30T01:21:08+01:00","body_html":"\u003cp dir=\"ltr\"\u003e\u003cspan\u003eImmerse yourself in a realm of floral splendour with Fothergill’s extensive collection of flower seeds. From timeless British garden favourites to native wildflowers, we offer a fantastic array to satisfy every gardener's desires. \u003c\/span\u003e\u003cspan\u003eOur range includes all of the UK’s most cherished blooms, tried and tested by gardening enthusiasts of all levels.\u003c\/span\u003e\u003c\/p\u003e\n\u003cp dir=\"ltr\"\u003e\u003cspan\u003eOur flower seeds have earned a reputation for healthy growth, vibrant colours, and exceptional performance – so you can cultivate a beautiful garden to enjoy all year round.\u003c\/span\u003e\u003c\/p\u003e\n\u003cp\u003e \u003c\/p\u003e","published_at":"2023-08-08T13:52:37+01:00","sort_order":"best-selling","template_suffix":"","disjunctive":false,"rules":[{"column":"tag","relation":"equals","condition":"product family:flower seeds"},{"column":"variant_inventory","relation":"greater_than","condition":"0"}],"published_scope":"global","image":{"created_at":"2023-08-08T13:52:35+01:00","alt":null,"width":800,"height":800,"src":"\/\/mr-fothergills.co.uk\/cdn\/shop\/collections\/MRF_flower_seeds_collection_banner_square.jpg?v=1701699131"}},{"id":466132828471,"handle":"flowers-to-sow-april","title":"Flower Seeds to Sow in April","updated_at":"2026-09-30T01:11:31+01:00","body_html":"\u003cp\u003eApril is the perfect time to sow a wide range of flower seeds, bringing colour and life to your garden throughout summer and beyond. With the soil warming up and longer days ahead, seeds germinate quickly, giving your plants plenty of time to establish.\u003c\/p\u003e\n\u003cp\u003eFrom classic cottage garden favourites like \u003ca href=\"https:\/\/mr-fothergills.co.uk\/collections\/sweet-pea-seeds\"\u003esweet pea seeds\u003c\/a\u003e to the big, bold colours of \u003ca href=\"https:\/\/mr-fothergills.co.uk\/collections\/cosmos-seeds\"\u003ecosmos seeds\u003c\/a\u003e, there’s something for every space. Many annuals sown this month will flower by mid-summer, while perennials started now will reward you with colour for years to come.\u003c\/p\u003e\n\u003cp\u003eBrowse our full selection of \u003ca href=\"https:\/\/mr-fothergills.co.uk\/collections\/flower-seeds\"\u003eflower seeds\u003c\/a\u003e and start planning your garden today. Looking for more inspiration? Check out our complete range of \u003ca href=\"https:\/\/mr-fothergills.co.uk\/collections\/wildflower-seeds\"\u003ewildflower seeds\u003c\/a\u003e to create a natural haven for pollinators.\u003c\/p\u003e","published_at":"2023-10-31T09:39:04+00:00","sort_order":"best-selling","template_suffix":"","disjunctive":false,"rules":[{"column":"tag","relation":"equals","condition":"Collection:Flowers To Sow In April"}],"published_scope":"global","image":{"created_at":"2025-03-13T08:59:52+00:00","alt":null,"width":3550,"height":1700,"src":"\/\/mr-fothergills.co.uk\/cdn\/shop\/collections\/Untitled_design_7_3b319673-6187-4abb-8d51-5ee19784a787.png?v=1741856392"}},{"id":466131648823,"handle":"flowers-to-sow-february","title":"Flowers To Sow In February","updated_at":"2026-09-30T01:11:30+01:00","body_html":"\u003cp\u003eFind the perfect flower seeds to sow in February UK with Fothergill's fantastic range. With warmer weather just around the corner, February is an excellent time to start growing your own flowers from seed. We have so many flower varieties perfect for sowing in February, each chosen for their high germination rates and beautiful, long-lasting blooms.\u003c\/p\u003e\n\u003cp\u003eOur fantastic range of February-sowing flowers includes many popular choices, like \u003ca href=\"https:\/\/mr-fothergills.co.uk\/collections\/cosmos-seeds\"\u003ecosmos seeds\u003c\/a\u003e, marigolds, geraniums, and even \u003ca href=\"https:\/\/mr-fothergills.co.uk\/collections\/wildflower-seeds\"\u003ewildflower seeds\u003c\/a\u003e. By sowing these seeds now, you'll be well-prepared for a stunning floral display in spring and summer. Explore our full collection of flower seeds to sow in February below.\u003c\/p\u003e","published_at":"2023-10-31T09:39:03+00:00","sort_order":"best-selling","template_suffix":"","disjunctive":false,"rules":[{"column":"tag","relation":"equals","condition":"Collection:Flowers To Sow In February"}],"published_scope":"global","image":{"created_at":"2025-04-14T15:30:13+01:00","alt":null,"width":3594,"height":3594,"src":"\/\/mr-fothergills.co.uk\/cdn\/shop\/collections\/A_colourful_wildflower_areabedmeadow._1_13bfccef-c362-4344-8e01-5e7c6bb011a2.jpg?v=1744641013"}},{"id":466132042039,"handle":"flowers-to-sow-january","title":"Flowers To Sow In January","updated_at":"2026-09-30T01:11:30+01:00","body_html":"\u003cp\u003eDiscover the perfect flower seeds to sow in January UK with Fothergill's. Whilst winter may seem an unlikely time for gardening, January is a great time to get a head start on your spring blooms. Sow \u003ca href=\"https:\/\/mr-fothergills.co.uk\/collections\/flower-seeds\"\u003eflower seeds\u003c\/a\u003e indoors in the warm and they’ll grow into strong, healthy plants, ready to start flowering when the weather warms.\u003c\/p\u003e\n\u003cp\u003eWe offer a fantastic range of January-sowing flower seeds, each chosen for their great performance in British gardens. You’ll find all of your favourites below, from fragrant \u003ca href=\"https:\/\/mr-fothergills.co.uk\/collections\/sweet-pea-seeds\"\u003esweet pea seeds\u003c\/a\u003e and frilly \u003ca href=\"https:\/\/mr-fothergills.co.uk\/collections\/carnation-seeds\"\u003ecarnations\u003c\/a\u003e to eye-catching \u003ca href=\"https:\/\/mr-fothergills.co.uk\/collections\/osteospermum-seeds\"\u003eOsteospermum\u003c\/a\u003e mixes. Browse our full range of flowers to sow in January and fill your garden with early spring colour.\u003c\/p\u003e","published_at":"2023-10-31T09:39:04+00:00","sort_order":"best-selling","template_suffix":"","disjunctive":false,"rules":[{"column":"tag","relation":"equals","condition":"Collection:Flowers To Sow In January"}],"published_scope":"global","image":{"created_at":"2025-04-14T15:22:57+01:00","alt":null,"width":800,"height":800,"src":"\/\/mr-fothergills.co.uk\/cdn\/shop\/collections\/Osteospermum_203D_20Blue_20Steel_2015_20Young_20Plants_1452737b-a059-4367-b202-e07315eeec3a.jpg?v=1744640577"}},{"id":466132697399,"handle":"flowers-to-sow-march","title":"Flowers To Sow In March","updated_at":"2026-09-30T01:11:31+01:00","body_html":null,"published_at":"2023-10-31T09:39:04+00:00","sort_order":"best-selling","template_suffix":null,"disjunctive":false,"rules":[{"column":"tag","relation":"equals","condition":"Collection:Flowers To Sow In March"}],"published_scope":"global"},{"id":458415800631,"handle":"formal-garden","title":"Formal Garden","updated_at":"2026-09-30T01:11:27+01:00","body_html":"\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eA formal garden showcases the beauty of flowers using a structured layout and often symmetrical design, creating a captivating sense of order and sophistication.\u003c\/span\u003e\u003c\/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eOur selection of formal garden flowers will help provide a harmonious blend of colours, shapes and sizes, resulting in a garden of fantastic visual appeal. Some of these varieties also release enchanting scents to infuse the air with a sense of luxury.\u003c\/span\u003e\u003c\/p\u003e\n\u003cp\u003e\u003cspan style=\"font-weight: 400;\"\u003eExplore our collection and elevate your garden with the allure of flowers that are tailored to create a formal garden at home.\u003c\/span\u003e\u003c\/p\u003e","published_at":"2023-08-18T12:41:41+01:00","sort_order":"best-selling","template_suffix":"","disjunctive":false,"rules":[{"column":"tag","relation":"equals","condition":"garden style:formal"}],"published_scope":"global","image":{"created_at":"2023-08-18T14:15:23+01:00","alt":null,"width":3357,"height":3357,"src":"\/\/mr-fothergills.co.uk\/cdn\/shop\/collections\/MRF_formal_garden_collection_banner.jpg?v=1692364523"}},{"id":454692340023,"handle":"half-hardy-annual-seeds","title":"Half Hardy Annuals","updated_at":"2026-09-30T01:11:25+01:00","body_html":"\u003cp\u003eBring vibrant colour and effortless charm to your garden with our half-hardy annual seeds, which are the perfect way to fill your beds, borders, and containers with a dazzling display that lasts all summer long.\u003c\/p\u003e\n\u003cp\u003eThese easy-to-grow half-hardy annual seeds are ideal for gardeners of every level, rewarding you with a rich mix of blooms that thrive in the warmth. From bright \u003ca href=\"https:\/\/mr-fothergills.co.uk\/collections\/marigold-seeds\"\u003emarigold seeds\u003c\/a\u003e and cheerful \u003ca href=\"https:\/\/mr-fothergills.co.uk\/collections\/zinnia-seeds\"\u003ezinnia seeds\u003c\/a\u003e to graceful \u003ca href=\"https:\/\/mr-fothergills.co.uk\/collections\/cosmos-seeds\"\u003ecosmos seeds\u003c\/a\u003e and delicately scented \u003ca href=\"https:\/\/mr-fothergills.co.uk\/collections\/nicotiana-seeds\"\u003enicotiana seeds\u003c\/a\u003e, each variety adds its own burst of character and colour.\u003c\/p\u003e\n\u003cp\u003eWhether you’re creating bold, eye-catching displays or a softer, cottage-garden look, our half-hardy annual seeds offer endless possibilities for summer planting. Simply sow them indoors in spring, then plant out once the frost has passed for months of vibrant colour and natural beauty.\u003c\/p\u003e\n\u003cp\u003eBuy your half-hardy annual seeds today and enjoy a garden bursting with colour, fragrance, and charm all season long.\u003c\/p\u003e","published_at":"2023-07-20T17:02:06+01:00","sort_order":"best-selling","template_suffix":"","disjunctive":false,"rules":[{"column":"tag","relation":"equals","condition":"plant class:half hardy annual"},{"column":"type","relation":"equals","condition":"FLOWER SEEDS"}],"published_scope":"global","image":{"created_at":"2023-08-23T15:41:56+01:00","alt":null,"width":3880,"height":3880,"src":"\/\/mr-fothergills.co.uk\/cdn\/shop\/collections\/MRF_half_hardy_annuals_collection_banner.jpg?v=1692801717"}},{"id":466132173111,"handle":"lobelia-seeds","title":"Lobelia Seeds","updated_at":"2026-09-30T01:11:31+01:00","body_html":"\u003cp\u003eLobelia seeds (\u003cem\u003eLobelia erinus\u003c\/em\u003e) are a fantastic choice for adding soft, delicate colour to your garden. A classic of summer bedding and container displays, this attractive \u003ca href=\"\/collections\/half-hardy-annual-seeds\"\u003ehalf-hardy annual\u003c\/a\u003e is extremely reliable and continually covered in tiny, bright blooms, often right until the first frosts. \u003c\/p\u003e\n\u003cp\u003eAt Fothergill’s, we have many wonderful and versatile lobelia seeds to suit every garden. Trailing lobelias are simply stunning in mixed \u003ca href=\"\/collections\/containers-pots-patio\"\u003epatio pots\u003c\/a\u003e and hanging baskets, while neat, compact varieties work well as ground cover in the border and formal bedding schemes – pair them with taller flowers like \u003ca href=\"\/collections\/antirrhinum-seeds\"\u003eantirrhinum seeds\u003c\/a\u003e to add visual interest and contrast. Explore Fothergill’s full range of lobelia seeds below and start growing your own today!\u003c\/p\u003e","published_at":"2023-10-31T09:39:04+00:00","sort_order":"best-selling","template_suffix":"","disjunctive":false,"rules":[{"column":"tag","relation":"equals","condition":"Collection:Lobelia Seeds"}],"published_scope":"global","image":{"created_at":"2025-01-23T15:14:38+00:00","alt":null,"width":800,"height":800,"src":"\/\/mr-fothergills.co.uk\/cdn\/shop\/collections\/Lobelia_20Queen_20Victoria_20Flower_20Plants.jpg?v=1737645279"}},{"id":481791803703,"handle":"sale","title":"SALE","updated_at":"2026-09-30T01:21:08+01:00","body_html":"","published_at":"2024-05-13T10:45:59+01:00","sort_order":"best-selling","template_suffix":"","disjunctive":false,"rules":[{"column":"product_metafield_definition","relation":"equals","condition":"true"},{"column":"is_price_reduced","relation":"is_set","condition":""},{"column":"variant_inventory","relation":"greater_than","condition":"0"}],"published_scope":"global"},{"id":468664844599,"handle":"spring-sowing-flower-seeds","title":"Spring Sowing Flower Seeds","updated_at":"2026-09-30T01:11:28+01:00","body_html":"\u003cp\u003eExplore a fantastic range of flower seeds to sow in spring at Fothergill’s. Our high-quality spring sowing \u003ca href=\"https:\/\/mr-fothergills.co.uk\/collections\/flower-seeds\"\u003eflower seeds\u003c\/a\u003e are perfect for bringing vibrant colour and life to your garden later in the year. Get sowing in February, March, and April to enjoy a stunning summer and autumn display. \u003c\/p\u003e\n\u003cp\u003eWhether you're an experienced gardener or just starting out, our selection of flower seeds to sow in spring will inspire and excite you. We carry all of the nation’s favourites, from delightfully fragranced \u003ca href=\"https:\/\/mr-fothergills.co.uk\/collections\/sweet-pea-seeds\"\u003esweet pea seeds\u003c\/a\u003e to colourful \u003ca href=\"https:\/\/mr-fothergills.co.uk\/collections\/cosmos-seeds\"\u003ecosmos seeds\u003c\/a\u003e and cheerful \u003ca href=\"https:\/\/mr-fothergills.co.uk\/collections\/petunia-seeds\"\u003epetunia seeds\u003c\/a\u003e. Choose from first-year flowering annuals to hardy perennials that will bloom year after year.\u003c\/p\u003e","published_at":"2023-12-04T14:24:56+00:00","sort_order":"best-selling","template_suffix":"","disjunctive":true,"rules":[{"column":"tag","relation":"equals","condition":"Collection:Flowers To Sow In February"},{"column":"tag","relation":"equals","condition":"Collection:Flowers To Sow In April"},{"column":"tag","relation":"equals","condition":"Collection:Flowers To Sow In March"}],"published_scope":"global","image":{"created_at":"2025-04-10T09:58:34+01:00","alt":null,"width":800,"height":800,"src":"\/\/mr-fothergills.co.uk\/cdn\/shop\/collections\/Petunia_20Tumbelina_20Candyfloss_2002_800x800_af3d5698-45c4-4b28-9f94-3f6b6957624e.jpg?v=1744275514"}}]});
