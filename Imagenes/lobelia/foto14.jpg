</style>
<div class="section  section--tight  section-blends section-full">
  <style>
      [data-breadcrumbs] [data-breadcrumb-middle] {
        display: none !important;
      }
      [data-breadcrumbs] [data-breadcrumb-ellipsis] {
        display: none !important;
      }

      /* Stay invisible until JS finishes the expand decision (mobile only — desktop needs no measure) */
      [data-breadcrumbs][data-ready] {
        opacity: 1;
        visibility: visible;
        transition: opacity 0.25s ease;
      }

      @media screen and (max-width: 767px) {
        [data-breadcrumbs]:not([data-ready]) {
          opacity: 0;
          visibility: hidden;
        }
        [data-breadcrumbs]:not([data-expanded]) [data-breadcrumb-list] {
          flex-wrap: nowrap !important;
        }
        [data-breadcrumbs]:not([data-expanded]) [data-breadcrumb-ellipsis] {
          display: inline-flex !important;
        }
        [data-breadcrumbs]:not([data-inline]):not([data-expanded]) [data-breadcrumb-current] {
          flex: 1 1 0;
          min-width: 0;
          max-width: 100%;
        }
        [data-breadcrumbs][data-inline]:not([data-expanded]) [data-breadcrumb-current] {
          flex: 0 1 auto;
          min-width: 0;
          max-width: 70%;
        }
        [data-breadcrumbs]:not([data-expanded]) [data-breadcrumb-current] [aria-current='page'] {
          overflow: hidden;
          text-overflow: ellipsis;
          white-space: nowrap;
        }
        [data-breadcrumbs][data-expanded] [data-breadcrumb-middle] {
          display: inline-flex !important;
        }
      }

      @media screen and (min-width: 768px) {
        /* Desktop always shows full trail — no measure needed */
        [data-breadcrumbs] {
          opacity: 1;
          visibility: visible;
        }
        [data-breadcrumbs] [data-breadcrumb-middle] {
          display: inline-flex !important;
        }
      }
    </style>
    <noscript>
      <style>
        [data-breadcrumbs] {
          opacity: 1 !important;
          visibility: visible !important;
        }
        @media screen and (max-width: 767px) {
