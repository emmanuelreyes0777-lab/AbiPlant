<script>
  (() => {
    const gallery = document.querySelector("[data-product-gallery-id='product-gallery-8334799831351-template--26102891807098__main']");

    if (!gallery) {
      return;
    }

    const mediaItems = Array.from(gallery.querySelectorAll('[data-gallery-media-item]'));
    const thumbnails = Array.from(gallery.querySelectorAll('[data-gallery-thumb]'));
    const zoomButtons = Array.from(gallery.querySelectorAll('[data-gallery-zoom-button]'));
    const mediaList = gallery.querySelector('[data-gallery-media-list]');
    const thumbnailsContainer = gallery.querySelector('[data-gallery-thumbnails]');
    const form = document.forms['product-form-8334799831351-template--26102891807098__main'];

    const syncThumbnailHeight = () => {
      if (!mediaList || !thumbnailsContainer || window.innerWidth < 1024) {
        if (thumbnailsContainer) {
          thumbnailsContainer.style.maxHeight = '';
        }
        thumbnails.forEach((thumb) => {
          thumb.style.width = '';
          thumb.style.height = '';
        });
        return;
      }

      const mediaHeight = mediaList.getBoundingClientRect().height;
      const roundedMediaHeight = mediaHeight > 0 ? Math.round(mediaHeight) : 0;
      thumbnailsContainer.style.maxHeight = roundedMediaHeight > 0 ? `${roundedMediaHeight}px` : '';

      const visibleThumbnails = thumbnails.filter((thumb) => !thumb.hidden && thumb.dataset.filtered !== 'true');

      if (visibleThumbnails.length === 4 && roundedMediaHeight > 0) {
        const thumbnailGap = 16;
        const fittedThumbnailSize = Math.floor((roundedMediaHeight - thumbnailGap * 3) / 4);
        const thumbnailSize = Math.min(188, fittedThumbnailSize);

        thumbnails.forEach((thumb) => {
          thumb.style.width = `${thumbnailSize}px`;
          thumb.style.height = `${thumbnailSize}px`;
        });
      } else {
        thumbnails.forEach((thumb) => {
          thumb.style.width = '';
          thumb.style.height = '';
        });
      }
    };

    const setActiveMedia = (mediaId) => {
      const activeId = String(mediaId);

      mediaItems.forEach((item) => {
        const isFiltered = item.dataset.filtered === 'true';
        const isActive = item.dataset.mediaId === activeId && !isFiltered;

        if (isActive) {
          // Prepare for fade-in
          item.hidden = false;
          item.style.opacity = '0';

          requestAnimationFrame(() => {
            item.style.opacity = '1';
          });
        } else {
          item.style.opacity = '0';
          item.hidden = true;
        }
      });

      thumbnails.forEach((thumb) => {
        const isFiltered = thumb.dataset.filtered === 'true';
        const isActive = thumb.dataset.mediaId === activeId && !isFiltered;

        thumb.hidden = isFiltered;
        thumb.setAttribute('aria-current', isActive ? 'true' : 'false');
      });

      requestAnimationFrame(syncThumbnailHeight);
    };

    const getFilteredPositions = (productData, variant) => {
      const filteredPositions = [];

      productData.media.forEach((media) => {
        let matchesFeaturedMedia = variant.featured_media && media.position === variant.featured_media.position;

        if (media.alt?.includes('#') && media.alt !== productData.title && !matchesFeaturedMedia) {
          const altParts = media.alt.split('#');
          const mediaGroupParts = altParts.pop().split('_');

          productData.options.forEach((option) => {
            if (option.name.toLowerCase() === mediaGroupParts[0].toLowerCase()) {
              const selectedValue = variant.options[option.position - 1]?.toLowerCase();

              if (selectedValue !== mediaGroupParts[1].trim().toLowerCase()) {
                filteredPositions.push(media.position);
              }
            }
          });
        }
      });

      return filteredPositions;
    };

    const applyVariantMedia = (productData, variant) => {
      const filteredPositions = getFilteredPositions(productData, variant);

      mediaItems.forEach((item) => {
        item.dataset.filtered = filteredPositions.includes(Number(item.dataset.mediaPosition)) ? 'true' : 'false';
      });

      thumbnails.forEach((thumb) => {
        thumb.dataset.filtered = filteredPositions.includes(Number(thumb.dataset.mediaPosition)) ? 'true' : 'false';
      });

      const featuredMediaId = variant.featured_media?.id;
      const visibleFeaturedMedia = featuredMediaId
        ? mediaItems.find(
            (item) => item.dataset.mediaId === String(featuredMediaId) && item.dataset.filtered !== 'true'
          )
        : null;
      const firstVisibleMedia = mediaItems.find((item) => item.dataset.filtered !== 'true');

      if (visibleFeaturedMedia) {
        setActiveMedia(featuredMediaId);
      } else if (firstVisibleMedia) {
        setActiveMedia(firstVisibleMedia.dataset.mediaId);
      }
    };

    thumbnails.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        setActiveMedia(thumb.dataset.mediaId);
      });
    });

    zoomButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const visibleImageItems = mediaItems.filter(
          (item) => item.dataset.mediaType === 'image' && item.dataset.filtered !== 'true' && !item.hidden
        );
        const openIndex = visibleImageItems.findIndex((item) => item.dataset.mediaId === button.dataset.mediaId);

        const targetIndex = openIndex >= 0 ? openIndex : 0;

        // Prefer calling the custom element's openZoom API when available
        if (typeof gallery.openZoom === 'function') {
          gallery.openZoom(targetIndex);
          return;
        }

        // Fallback: dispatch lightbox event for any listeners
        gallery.dispatchEvent(
          new CustomEvent('lightbox:open', {
            bubbles: true,
            detail: {
              index: targetIndex
            }
          })
        );
      });
    });

    if (form) {
      form.addEventListener('variant:change', (event) => {
        applyVariantMedia(event.detail.product, event.detail.variant);
      });
    }

    setActiveMedia('63746096398714');

    if (mediaList && 'ResizeObserver' in window) {
      const resizeObserver = new ResizeObserver(() => {
        syncThumbnailHeight();
      });
      resizeObserver.observe(mediaList);
    }

    window.addEventListener('resize', syncThumbnailHeight);
  })();
</script>
