    @media screen and (min-width: 1000px) {
      #shopify-section-template--26102891807098__main {
        --product-grid: auto / minmax(0, 1fr) minmax(320px, 430px);
        --product-gallery-media-list-grid: auto / auto-flow 100%;
        --product-gallery-media-list-gap: calc(var(--grid-gutter) / 2);
      }

      /* Lock column widths: long PDP tab copy must not inflate min-content and shift the whole grid */
