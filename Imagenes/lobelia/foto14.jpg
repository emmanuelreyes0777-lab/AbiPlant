    <script>
      (() => {
        const initPipCarousel = (wrap) => {
          const viewport = wrap.querySelector('[data-pip-carousel-viewport]');
          const track = wrap.querySelector('[data-pip-carousel-track]');
          if (!viewport || !track) {
            return;
          }
          const slides = Array.from(viewport.querySelectorAll('[role="tabpanel"]'));
          const radios = Array.from(wrap.querySelectorAll(':scope > input[type="radio"]'));
          if (slides.length === 0 || slides.length !== radios.length) {
            return;
          }

          let activeIndex = radios.findIndex((r) => r.checked);
          if (activeIndex < 0) {
            activeIndex = 0;
          }

          const motionMq = window.matchMedia('(prefers-reduced-motion: reduce)');
          const slideEasing = 'cubic-bezier(0.33, 1, 0.68, 1)';
          const slideDuration = '0.5s';

          const setTranslate = (index, instant) => {
            const w = viewport.getBoundingClientRect().width;
            if (w <= 0) {
              return;
            }
            slides.forEach((slide) => {
              slide.style.flex = `0 0 ${w}px`;
              slide.style.width = `${w}px`;
            });
            const useInstant = instant || motionMq.matches;
            /* Inline transition so it always runs; scoped CSS alone can lose specificity. */
            if (useInstant) {
              track.style.transition = 'none';
            } else {
              track.style.transition = `transform ${slideDuration} ${slideEasing}`;
            }
            track.style.transform = `translate3d(${-index * w}px, 0, 0)`;
            if (useInstant) {
              void track.offsetWidth;
              track.style.removeProperty('transition');
            }
            const activeSlide = slides[index];
            if (activeSlide) {
              const nextH = `${activeSlide.scrollHeight}px`;
              if (useInstant) {
                viewport.style.transition = 'none';
              }
              viewport.style.height = nextH;
              if (useInstant) {
                void viewport.offsetHeight;
                viewport.style.removeProperty('transition');
              }
            }
            slides.forEach((slide, i) => {
              slide.setAttribute('aria-hidden', i === index ? 'false' : 'true');
            });
            wrap.dataset.pipTabPrev = String(index);
          };

          const layout = (instant) => {
            setTranslate(activeIndex, instant);
          };

          radios.forEach((radio, i) => {
            radio.addEventListener('change', () => {
              if (!radio.checked) {
                return;
              }
              activeIndex = i;
              layout(false);
            });
          });

          let resizeRaf = 0;
          const onResize = () => {
            cancelAnimationFrame(resizeRaf);
            resizeRaf = requestAnimationFrame(() => setTranslate(activeIndex, true));
          };
          window.addEventListener('resize', onResize);
          /*
            Do not ResizeObserver the viewport: changing tab updates viewport height, which
            would fire RO and call setTranslate(..., true), wiping transition: none mid-animation.
          */

          motionMq.addEventListener('change', () => setTranslate(activeIndex, true));

          const roSlides = new ResizeObserver(() => {
            const h = slides[activeIndex]?.scrollHeight;
            if (h) {
              viewport.style.height = `${h}px`;
            }
          });
          slides.forEach((slide) => {
            roSlides.observe(slide);
          });

          requestAnimationFrame(() => {
            layout(true);
            requestAnimationFrame(() => layout(true));
          });
        };

        document.querySelectorAll('.pip-dsk-tab-wrap').forEach((wrap) => {
          if (wrap.dataset.pipCarouselReady) {
            return;
          }
          wrap.dataset.pipCarouselReady = 'true';
          initPipCarousel(wrap);
        });
      })();
    </script>
